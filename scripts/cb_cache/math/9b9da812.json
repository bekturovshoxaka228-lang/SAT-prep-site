ont-family: Noto Serif; font-size: 15px;\" x=\"0\">3</text></g><g class=\"tick x-tick\" opacity=\"1\" transform=\"translate(182.4720775462963,0)\"><line stroke=\"currentColor\" y2=\"6px\" y1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" y=\"8\" dy=\"0.71em\" style=\"font-family: Noto Serif; font-size: 15px;\" x=\"0\">4</text></g><g class=\"tick x-tick\" opacity=\"1\" transform=\"translate(227.96509693287038,0)\"><line stroke=\"currentColor\" y2=\"6px\" y1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" y=\"8\" dy=\"0.71em\" style=\"font-family: Noto Serif; font-size: 15px;\" x=\"0\">5</text></g><g class=\"tick x-tick\" opacity=\"1\" transform=\"translate(273.45811631944446,0)\"><line stroke=\"currentColor\" y2=\"6px\" y1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" y=\"8\" dy=\"0.71em\" style=\"font-family: Noto Serif; font-size: 15px;\" x=\"0\">6</text></g><line class=\"x-axis-line\" x1=\"-15\" x2=\"293.328125\" stroke=\"currentColor\" stroke-width=\"1.5px\"></line><line class=\"x-axis-line\" x1=\"-15\" x2=\"293.328125\" stroke=\"currentColor\" stroke-width=\"1.5px\" marker-end=\"url(#arrow)\"></line><text class=\"x-axis-label\" style=\"text-anchor: start; dominant-baseline: middle; font-family: Noto Serif; font-style: italic; fill: currentColor; font-size: 15px;\" transform=\"translate(305.328125,0)\">x</text></g><g class=\"y-axis-group\" fill=\"none\" font-size=\"10\" font-family=\"sans-serif\" text-anchor=\"end\" transform=\"translate(0,0)\"><g class=\"tick y-tick\" opacity=\"1\" transform=\"translate(0,248.33510561342595)\"><line stroke=\"currentColor\" x2=\"6px\" x1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" x=\"-8\" dy=\"0.32em\" style=\"font-family: Noto Serif; font-size: 15px;\">1</text></g><g class=\"tick y-tick\" opacity=\"1\" transform=\"translate(0,202.84208622685185)\"><line stroke=\"currentColor\" x2=\"6px\" x1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" x=\"-8\" dy=\"0.32em\" style=\"font-family: Noto Serif; font-size: 15px;\">2</text></g><g class=\"tick y-tick\" opacity=\"1\" transform=\"translate(0,157.34906684027777)\"><line stroke=\"currentColor\" x2=\"6px\" x1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" x=\"-8\" dy=\"0.32em\" style=\"font-family: Noto Serif; font-size: 15px;\">3</text></g><g class=\"tick y-tick\" opacity=\"1\" transform=\"translate(0,111.85604745370371)\"><line stroke=\"currentColor\" x2=\"6px\" x1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" x=\"-8\" dy=\"0.32em\" style=\"font-family: Noto Serif; font-size: 15px;\">4</text></g><g class=\"tick y-tick\" opacity=\"1\" transform=\"translate(0,66.36302806712962)\"><line stroke=\"currentColor\" x2=\"6px\" x1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" x=\"-8\" dy=\"0.32em\" style=\"font-family: Noto Serif; font-size: 15px;\">5</text></g><g class=\"tick y-tick\" opacity=\"1\" transform=\"translate(0,20.870008680555554)\"><line stroke=\"currentColor\" x2=\"6px\" x1=\"-6px\" stroke-width=\"1px\"></line><text fill=\"currentColor\" x=\"-8\" dy=\"0.32em\" style=\"font-family: Noto Serif; font-size: 15px;\">6</text></g><line class=\"y-axis-line\" y1=\"308.328125\" y2=\"0\" stroke=\"currentColor\" stroke-width=\"1.5px\"></line><line class=\"y-axis-line\" y1=\"308.328125\" y2=\"0\" stroke=\"currentColor\" stroke-width=\"1.5px\" marker-end=\"url(#arrow)\"></line><text class=\"y-axis-label\" style=\"text-anchor: middle; dominant-baseline: text-after-edge; font-family: Noto Serif; font-style: italic; fill: currentColor; font-size: 15px;\" transform=\"translate(0,-12)\">y</text></g><text x=\"0\" y=\"293.328125\" dx=\"-13.25px\" dy=\"13.5px\" fill=\"currentColor\" style=\"font-size: 15px; font-style: italic; font-family: Noto Serif;\">O</text><circle cx=\"0\" cy=\"293.328125\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"45.493019386574076\" cy=\"261.9379416232639\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"90.98603877314815\" cy=\"242.83087348090277\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"136.47905815972223\" cy=\"209.16603913483794\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"181.9720775462963\" cy=\"186.41952944155096\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"227.46509693287038\" cy=\"152.29976490162034\" r=\"4px\" fill=\"currentColor\"></circle></g></svg><div role=\"region\" aria-label=\"Long description for scatterplot\" class=\"sr-only\"><ul><li>The scatterplot has 6 data points.</li><li>The data points are in a linear pattern trending up from left to right.</li><li>The data points have the following approximate coordinates:<ul><li>(0 comma 0)</li><li>(1 comma 0.7)</li><li>(2 comma 1.1)</li><li>(3 comma 1.9)</li><li>(4 comma 2.4)</li><li>(5 comma 3.1)</li></ul></li></ul></div></figure></p>\n<p style=\"text-align: left;\">Which of the following equations is the most appropriate linear model for the data shown in the scatterplot?</p>", "keys": ["1e421165-ee16-4c4a-b571-d35534be6ac2"], "answerOptions": [{"id": "c44d647e-7214-49b3-b15e-f42374fbd45f", "content": "<p><math alttext=\"y equals minus 0.606 x\"><mrow>\n\t<mi>y</mi>\n\t<mo>=</mo>\n\t<mrow>\n\t\t<mo>-</mo>\n\t\t<mn>0.606</mn>\n\t\t<mi>x</mi>\n\t</mrow>\n</mrow>\n</math></p>"}, {"id": "2b3e4fdb-2f32-4eb9-9281-810d8f1b360e", "content": "<p><math alttext=\"y equals 0.606 minus 1.001 x\"><mrow>\n\t<mi>y</mi>\n\t<mo>=</mo>\n\t<mn>0.606</mn>\n</mrow>\n<mo>-</mo><mn>1.001</mn><mi>x</mi></math></p>"}, {"id": "1e421165-ee16-4c4a-b571-d35534be6ac2", "content": "<p><math alttext=\"y equals 0.606 x\"><mrow>\n\t<mi>y</mi>\n\t<mo>=</mo>\n\t<mrow>\n\t\t<mn>0.606</mn>\n\t\t<mi>x</mi>\n\t</mrow>\n</mrow>\n</math></p>"}, {"id": "4b65bf36-28da-48b4-a248-347653766786", "content": "<p><math alttext=\"y equals 0.606 plus 1.001 x\"><mrow>\n\t<mi>y</mi>\n\t<mo>=</mo>\n\t<mn>0.606</mn>\n</mrow>\n<mo>+</mo><mn>1.001</mn><mi>x</mi></math></p>"}], "rationale": "<p>Choice C is correct. A linear model can be written in the form <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals m x plus b\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>b</mi></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math> is the slope of the graph of the model in the <em>xy</em>-plane and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma b right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mi>b</mi><mo>)</mo></math> is the <em>y</em>-intercept. The graph of an appropriate linear model for the data shown in the scatterplot passes near the points <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 4 comma 2.4 right parenthesis\"><mo>(</mo><mn>4</mn><mo>,</mo><mn>2.4</mn><mo>)</mo></math> in the <em>xy</em>-plane. Two points on a line, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis x 1 comma y 1 right parenthesis\"><mfenced><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub></mrow></mfenced></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis x 2 comma y 2 right parenthesis\"><mfenced><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mfenced></math>,&nbsp;can be used to find the slope of the line using the slope formula, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction y 2 minus y 1 Over x 2 minus x 1 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>-</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>-</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></math>. Substituting the points <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 4 comma 2.4 right parenthesis\"><mo>(</mo><mn>4</mn><mo>,</mo><mn>2.4</mn><mo>)</mo></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis x Subscript 1 comma Baseline y 1 right parenthesis\"><mfenced><mrow><msub><mi>x</mi><mrow><mn>1</mn><mo>,</mo></mrow></msub><msub><mi>y</mi><mn>1</mn></msub></mrow></mfenced></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis x 2 comma y 2 right parenthesis\"><mfenced><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mfenced></math>, respectively, in the slope formula yields <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction 2.4 minus 0 Over 4 minus 0 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><mn>2.4</mn><mo>-</mo><mn>0</mn></mrow><mrow><mn>4</mn><mo>-</mo><mn>0</mn></mrow></mfrac></math>, or <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals 0.60\"><mi>m</mi><mo>=</mo><mn>0.60</mn></math>. Therefore, the value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math> for an appropriate linear model is approximately <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"0.60\"><mn>0.60</mn></math>. Substituting <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"0.60\"><mn>0.60</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math> in <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals m x plus b\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>b</mi></math> yields <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals 0.60 x plus b\"><mi>y</mi><mo>=</mo><mn>0.60</mn><mi>x</mi><mo>+</mo><mi>b</mi></math>. Since an appropriate linear model passes near the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math>, it follows that <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"b\"><mi>b</mi></math> is approximately <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"0\"><mn>0</mn></math>&nbsp;and an appropriate linear model for the data is <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals 0.60 x plus 0\"><mi>y</mi><mo>=</mo><mn>0.60</mn><mi>x</mi><mo>+</mo><mn>0</mn></math>. Thus, of the given choices, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals 0.606 x\"><mi>y</mi><mo>=</mo><mn>0.606</mn><mi>x</mi></math> is the most appropriate linear model for these data.</p>\n<p>Alternate approach: A linear model can be written in the form <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals m x plus b\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>b</mi></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math> is the slope of the graph of the model in the <em>xy</em>-plane and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma b right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mi>b</mi><mo>)</mo></math> is the <em>y</em>-intercept. The scatterplot shows that as the <em>x</em>-values of the data points increase, the <em>y</em>-values of the data points increase, which means the graph of an appropriate linear model has a positive slope. The scatterplot also shows that an appropriate linear model would pass close to the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math>. Of the given choices, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals 0.606 x\"><mi>y</mi><mo>=</mo><mn>0.606</mn><mi>x</mi></math> is the only linear model whose graph has a positive slope and a <em>y</em>-intercept of <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math>.</p>\n<p>Choice A is incorrect. The graph of this model has a negative slope, not a positive slope.</p>\n<p>Choice B is incorrect. The graph of this model has a negative slope, not a positive slope, and a<em> y</em>-intercept that is not <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math>.</p>\n<p>Choice D is incorrect. The graph of this model has a slope that is too steep to fit the data, and a <em>y</em>-intercept that is not <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 0 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math>.</p>", "externalid": "9fe0c563-5c49-44d6-bd3d-3956ed2de2bd", "correct_answer": ["C"]}