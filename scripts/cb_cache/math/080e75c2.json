x\" fill=\"none\" stroke-dasharray=\"none\"></path><path d=\"M0,113.99L198.621,41.764\" stroke=\"black\" stroke-width=\"2px\" fill=\"none\" stroke-dasharray=\"none\"></path><circle cx=\"0\" cy=\"41.444864908854164\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"0\" cy=\"113.98954264322917\" r=\"4px\" fill=\"currentColor\"></circle><circle cx=\"132.99857584635419\" cy=\"65.62642415364583\" r=\"4px\" fill=\"currentColor\"></circle></g><g class=\"xtitle-group\" transform=\"translate(237.015625, 254.625)\"><text class=\"xtitle-group-line-0\" transform=\"translate(0, 0)\" fill=\"currentColor\" style=\"font-family: Noto Serif; font-size: 15px;\" text-anchor=\"middle\" dominant-baseline=\"hanging\">Years since 2010</text></g><g class=\"ytitle-group\" transform=\"translate(51.3515625, 104.3125)\"><text class=\"ytitle-group-line-0\" transform=\"translate(0, 0)\" fill=\"currentColor\" style=\"font-family: Noto Serif; font-size: 15px;\" text-anchor=\"middle\" dominant-baseline=\"text-before-edge\">Number of</text><text class=\"ytitle-group-line-1\" transform=\"translate(0, 20)\" fill=\"currentColor\" style=\"font-family: Noto Serif; font-size: 15px;\" text-anchor=\"middle\" dominant-baseline=\"text-before-edge\">participants</text><text class=\"ytitle-group-line-2\" transform=\"translate(0, 40)\" fill=\"currentColor\" style=\"font-family: Noto Serif; font-size: 15px;\" text-anchor=\"middle\" dominant-baseline=\"text-before-edge\">(in thousands)</text></g></svg><div role=\"region\" aria-label=\"Long description for graph of a system of 2 lines\" class=\"sr-only\"><ul>\n<li>For the first line in the system:\n<ul>\n<li>The line slants gradually up from left to right.</li>\n<li>The line passes through the following points:\n<ul>\n<li>(0 comma 7)</li>\n<li>(11 comma 11)</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>For the second line in the system:\n<ul>\n<li>The line slants gradually down from left to right.</li>\n<li>The line passes through the following points:\n<ul>\n<li>(0 comma 13)</li>\n<li>(11 comma 11)</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>The 2 lines intersect at 1 point.</li>\n</ul></div></figure></p>\n<p style=\"text-align: left;\">The functions <math alttext=\"f\"><mi>f</mi>\n</math> and <math alttext=\"g\"><mi>g</mi>\n</math> model the number of participants, in thousands, in two different programs <math alttext=\"x\"><mi>x</mi>\n</math> years since <math alttext=\"2010\"><mn>2010</mn></math>. The graphs of <math alttext=\"y equals f left parenthesis x right parenthesis\"><mi>y</mi><mo>=</mo><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo></math> and <math alttext=\"y equals g left parenthesis x right parenthesis\"><mi>y</mi><mo>=</mo><mi>g</mi><mo>(</mo><mi>x</mi><mo>)</mo></math> are shown. Which of the following could represent functions <math alttext=\"f\"><mi>f</mi>\n</math> and <math alttext=\"g\"><mi>g</mi>\n</math>?</p>", "keys": ["e4c56f5a-331b-4c96-905d-d00ee69efe6d"], "answerOptions": [{"id": "f17fbdd9-e175-43fb-8f38-15b0a3661cac", "content": "<p><math alttext=\"f left parenthesis x right parenthesis equals minus four elevenths x plus 13\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math></p>\n<p><math alttext=\"g left parenthesis x right parenthesis equals two elevenths x plus 7\"><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfrac><mn>2</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math></p>"}, {"id": "3c53976c-6150-4f81-8bad-d7d6d0308ddc", "content": "<p><math alttext=\"f left parenthesis x right parenthesis equals minus four elevenths x plus 7\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math></p>\n<p><math alttext=\"g left parenthesis x right parenthesis equals two elevenths x plus 13\"><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfrac><mn>2</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math></p>"}, {"id": "e4c56f5a-331b-4c96-905d-d00ee69efe6d", "content": "<p><math alttext=\"f left parenthesis x right parenthesis equals minus two elevenths x plus 13\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mfrac><mn>2</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math></p>\n<p><math alttext=\"g left parenthesis x right parenthesis equals four elevenths x plus 7\"><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math></p>"}, {"id": "a0efbd48-f7c8-4533-a3ac-fd9f8419cf43", "content": "<p><math alttext=\"f left parenthesis x right parenthesis equals minus two elevenths x plus 7\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mfrac><mn>2</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math></p>\n<p><math alttext=\"g left parenthesis x right parenthesis equals four elevenths x plus 13\"><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math></p>"}], "rationale": "<p style=\"text-align: left;\">Choice C is correct. A line in the <em>xy</em>-plane that passes through the points <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis x 1 comma y 1 right parenthesis\"><mo>(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis x 2 comma y 2 right parenthesis\"><mo>(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo>)</mo></math> has slope <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction y 2 minus y 1 Over x 2 minus x 1 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>-</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>-</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></math>. The equation of the line can be written in the form&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals m x plus b\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>b</mi></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"b\"><mi>b</mi></math> is the <em>y</em>-intercept represented by <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma b right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mi>b</mi><mo>)</mo></math>. One of the lines shown in the graph passes through the points <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 7 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>7</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 11 comma 11 right parenthesis\"><mo>(</mo><mn>11</mn><mo>,</mo><mn>11</mn><mo>)</mo></math>. Substituting <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"0\"><mn>0</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"x 1\"><msub><mi>x</mi><mn>1</mn></msub></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"7\"><mn>7</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y 1\"><msub><mi>y</mi><mn>1</mn></msub></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"11\"><mn>11</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"x 2\"><msub><mi>x</mi><mn>2</mn></msub></math>, and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"11\"><mn>11</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y 2\"><msub><mi>y</mi><mn>2</mn></msub></math> in the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction y 2 minus y 1 Over x 2 minus x 1 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>-</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>-</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></math> yields <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction 11 minus 7 Over 11 minus 0 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><mn>11</mn><mo>-</mo><mn>7</mn></mrow><mrow><mn>11</mn><mo>-</mo><mn>0</mn></mrow></mfrac></math>, or <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals four elevenths\"><mi>m</mi><mo>=</mo><mfrac><mn>4</mn><mn>11</mn></mfrac></math>. Substituting <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"four elevenths\"><mfrac><mn>4</mn><mn>11</mn></mfrac></math> for&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"7\"><mn>7</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"b\"><mi>b</mi></math> in the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals m x plus b\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>b</mi></math> yields <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals four elevenths x plus 7\"><mi>y</mi><mo>=</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math>. Therefore, an equation of this line is <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals four elevenths x plus 7\"><mi>y</mi><mo>=</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math>. Similarly, the other line shown in the graph passes through the points <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 0 comma 13 right parenthesis\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>13</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 11 comma 11 right parenthesis\"><mo>(</mo><mn>11</mn><mo>,</mo><mn>11</mn><mo>)</mo></math>. Substituting <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"0\"><mn>0</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"x 1\"><msub><mi>x</mi><mn>1</mn></msub></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"13\"><mn>13</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y 1\"><msub><mi>y</mi><mn>1</mn></msub></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"11\"><mn>11</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"x 2\"><msub><mi>x</mi><mn>2</mn></msub></math>, and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"11\"><mn>11</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y 2\"><msub><mi>y</mi><mn>2</mn></msub></math> in the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction y 2 minus y 1 Over x 2 minus x 1 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>-</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>-</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mfrac></math> yields <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction 11 minus 13 Over 11 minus 0 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><mn>11</mn><mo>-</mo><mn>13</mn></mrow><mrow><mn>11</mn><mo>-</mo><mn>0</mn></mrow></mfrac></math>, or <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m equals StartFraction negative 2 Over 11 EndFraction\"><mi>m</mi><mo>=</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>11</mn></mfrac></math>. Substituting <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"StartFraction negative 2 Over 11 EndFraction\"><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>11</mn></mfrac></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"m\"><mi>m</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"13\"><mn>13</mn></math> for <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"b\"><mi>b</mi></math> in the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals m x plus b\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>b</mi></math> yields <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals StartFraction negative 2 Over 11 EndFraction x plus 13\"><mi>y</mi><mo>=</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math>. Therefore, an equation of this line is <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"y equals StartFraction negative 2 Over 11 EndFraction x plus 13\"><mi>y</mi><mo>=</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math>. So, the functions <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"f\"><mi>f</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"g\"><mi>g</mi></math> could be represented by <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"f left parenthesis x right parenthesis equals StartFraction negative 2 Over 11 EndFraction x plus 13\"><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>13</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"g left parenthesis x right parenthesis equals four elevenths x plus 7\"><mi>g</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo><mfrac><mn>4</mn><mn>11</mn></mfrac><mi>x</mi><mo>+</mo><mn>7</mn></math>.</p>\n<p>Choice A is incorrect and may result from conceptual or calculation errors.&nbsp;</p>\n<p>Choice B is incorrect and may result from conceptual or calculation errors.&nbsp;</p>\n<p>Choice D is incorrect and may result from conceptual or calculation errors.&nbsp;</p>", "externalid": "4e08d101-c21c-44f2-a0d1-b1575f5b4632", "correct_answer": ["C"]}