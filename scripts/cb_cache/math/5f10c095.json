0.640625 35.9375 13.953125 39.203125 \nQ 17.28125 42.484375 20.3125 42.484375 \nz\n\" id=\"CrimsonText-Italic-120\"></path>\n     </defs>\n     <g transform=\"translate(254.98864 234.089376)scale(0.15 -0.15)\">\n      <use xlink:href=\"#CrimsonText-Italic-120\"></use>\n     </g>\n    </g>\n   </g>\n   <g id=\"line2d_1\">\n    <path clip-path=\"url(#p393e7d194c)\" d=\"M 68.965778 253.229234 \nL 71.9093 229.35244 \nL 74.852822 207.205402 \nL 77.796344 186.788118 \nL 80.739865 168.100588 \nL 83.262884 153.45945 \nL 85.785903 140.089152 \nL 88.308921 127.989694 \nL 90.411437 118.877593 \nL 92.513953 110.648019 \nL 94.616468 103.300974 \nL 96.718984 96.836457 \nL 98.400996 92.300264 \nL 100.083009 88.328888 \nL 101.765021 84.92233 \nL 103.447034 82.08059 \nL 104.708543 80.319947 \nL 105.970052 78.877014 \nL 107.231562 77.75179 \nL 108.493071 76.944277 \nL 109.75458 76.454474 \nL 111.01609 76.282381 \nL 112.277599 76.427999 \nL 113.539108 76.891326 \nL 114.800618 77.672363 \nL 116.062127 78.77111 \nL 117.323636 80.187568 \nL 118.585146 81.921735 \nL 119.846655 83.973612 \nL 121.528667 87.203665 \nL 123.21068 90.998535 \nL 124.892692 95.358223 \nL 126.574705 100.282729 \nL 128.67722 107.232636 \nL 130.779736 115.065072 \nL 132.882251 123.780035 \nL 134.984767 133.377527 \nL 137.507786 146.059453 \nL 140.030804 160.01222 \nL 142.553823 175.235827 \nL 145.076842 191.730274 \nL 148.020364 212.579997 \nL 150.963885 235.159474 \nL 153.066401 252.346706 \nL 153.066401 252.346706 \n\" style=\"fill:none;stroke:#000000;stroke-linecap:square;stroke-width:2.3;\"></path>\n   </g>\n   <g id=\"line2d_2\">\n    <path clip-path=\"url(#p393e7d194c)\" d=\"M 32.382007 93.450101 \nL 242.213061 93.450101 \nL 242.213061 93.450101 \n\" style=\"fill:none;stroke:#000000;stroke-linecap:square;stroke-width:2.3;\"></path>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"p393e7d194c\">\n   <rect height=\"260.82\" width=\"259.665929\" x=\"10.612035\" y=\"7.2\"></rect>\n  </clipPath>\n </defs>\n</svg>\n<div role=\"region\" aria-label=\"Long description for graph of a system of a line and a parabola \" class=\"sr-only\"><ul><li>For the line in the system:<br>\n<ul>\n<li>The line is horizontal.</li>\n<li>The line passes through the following points:<br>\n<ul>\n<li>(0 comma 7.2)</li>\n<li>(4 comma 7.2)</li>\n<li>(6 comma 7.2)</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>For the parabola in the system:<br>\n<ul>\n<li>The parabola opens downward.</li>\n<li>The vertex is at the point (5 comma 8.1).</li>\n<li>The parabola passes through the following points:<br>\n<ul>\n<li>(2 comma 0)&nbsp;</li>\n<li>(4 comma 7.2)</li>\n<li>(6 comma 7.2)</li>\n<li>(8 comma 0)</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul></div></figure></p>\n<p style=\"text-align: left;\">The graph of a system of a linear equation and a quadratic equation is shown. A solution to the system is <math alttext=\"left parenthesis x comma y right parenthesis\"><mfenced><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></mfenced></math>. What is a possible value of <math alttext=\"x\"><mi>x</mi>\n</math>?&nbsp;</p>", "keys": ["96e13b58-d778-4625-a185-6fe80913751c"], "answerOptions": [{"id": "96e13b58-d778-4625-a185-6fe80913751c", "content": "<p><math alttext=\"4\"><mn>4</mn>\n</math></p>"}, {"id": "5b63c81d-eb05-4a4b-9112-7e552bcb9c9d", "content": "<p><math alttext=\"5\"><mn>5</mn>\n</math></p>"}, {"id": "f062bcaa-ba99-4033-94a4-ee7841e390a6", "content": "<p><math alttext=\"7.2\"><mn>7.2</mn>\n</math></p>"}, {"id": "52ac14db-84b6-4119-80d0-04000eda5855", "content": "<p><math alttext=\"8\"><mn>8</mn>\n</math></p>"}], "rationale": "<p style=\"text-align: left;\">Choice A is correct. The solutions to the system correspond to the points where the graphs of the equations intersect. The graphs of the linear equation and the quadratic equation shown intersect at approximately <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 4 comma 7.2 right parenthesis\"><mo>(</mo><mn>4</mn><mo>,</mo><mn>7.2</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"left parenthesis 6 comma 7.2 right parenthesis\"><mo>(</mo><mn>6</mn><mo>,</mo><mn>7.2</mn><mo>)</mo></math>. It follows that the possible values of <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"x\"><mi>x</mi></math> are <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"4\"><mn>4</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"6\"><mn>6</mn></math>. Of these two possible values, only <math xmlns=\"http://www.w3.org/1998/Math/MathML\" alttext=\"4\"><mn>4</mn></math> is given as a choice.</p>\n<p style=\"text-align: left;\">Choice B is incorrect. This is the&nbsp;<em>x</em>-value of the vertex of the graph of the quadratic equation, not the&nbsp;<em>x</em>-value of a solution to the system.</p>\n<p style=\"text-align: left;\">Choice C is incorrect. This is the approximate&nbsp;<em>y</em>-value, not the&nbsp;<em>x</em>-value, of a solution to the system.</p>\n<p style=\"text-align: left;\">Choice D is incorrect. This is the&nbsp;<em>x</em>-value of an <em>x</em>-intercept of the graph of the quadratic equation.</p>", "externalid": "0b32b9eb-51a8-404e-b6ad-8166b494f610", "correct_answer": ["A"]}