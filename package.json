{
  "name": "sat-ielts-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified platform for IELTS Academic and Digital SAT preparation",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "dev:api": "cd apps/api && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "test:api": "cd apps/api && .venv\\Scripts\\pytest -v"
  }
}
